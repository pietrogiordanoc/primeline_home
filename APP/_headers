# Stable URLs cache for one hour, then require revalidation.
/images/*
  Cache-Control: public, max-age=3600, must-revalidate

/images/*/*
  Cache-Control: public, max-age=3600, must-revalidate

/images/*/*/*
  Cache-Control: public, max-age=3600, must-revalidate

/images/*/*/*/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/css/*.css
  Cache-Control: public, max-age=3600, must-revalidate

/assets/js/*.js
  Cache-Control: public, max-age=3600, must-revalidate

/catalog-pdf/*.css
  Cache-Control: public, max-age=3600, must-revalidate

/catalog-pdf/*.js
  Cache-Control: public, max-age=3600, must-revalidate

/catalog-pdf/*/*.css
  Cache-Control: public, max-age=3600, must-revalidate

/catalog-pdf/*/*.js
  Cache-Control: public, max-age=3600, must-revalidate
